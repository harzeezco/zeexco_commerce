APP_ENV=development
PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
# Per-client fixed-window limits. Limits are local to each API process.
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_REGISTER=5
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REFRESH=20
RATE_LIMIT_ONBOARDING_VALIDATE=30
RATE_LIMIT_WEBHOOK=120
DATABASE_URL=
# Dedicated PostgreSQL URL used only by `go test -tags=integration`.
TEST_DATABASE_URL=postgres://zeexco_test:local_test_password@localhost:5434/zeexco_test?sslmode=disable
# Base64-encoded Ed25519 PKCS#8 private key and PKIX public key PEM files.
# Generate local keys as documented in README.md. Never commit real key values.
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=
AUTH_JWT_ISSUER=zeexco
AUTH_JWT_AUDIENCE=zeexco-api
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_REFRESH_COOKIE_NAME=zeexco_refresh
AUTH_REFRESH_COOKIE_DOMAIN=
# Production default is true. Set false explicitly only for local HTTP development.
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
# Required for browser registration and activation. Use a Resend sending-only API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Zeexco <accounts@example.com>
RESEND_API_BASE_URL=https://api.resend.com
# Frontend page that reads ?token= and POSTs it to /api/v1/auth/verify-email.
EMAIL_VERIFICATION_FRONTEND_URL=https://www.zeexco.com/activate-account
# Base64-encoded random secret of at least 32 decoded bytes.
EMAIL_VERIFICATION_HMAC_SECRET_BASE64=
EMAIL_VERIFICATION_TTL=24h
EMAIL_WORKER_POLL_INTERVAL=250ms
EMAIL_WORKER_RETRY_BASE_DELAY=30s
EMAIL_WORKER_PROCESSING_LEASE=5m
# Webhook handshake secret chosen by Zeexco. This is not a Meta access token or app secret.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_a_secure_random_token
# Meta Developer app secret used only to verify signed POST webhook payloads.
META_APP_SECRET=replace_with_your_meta_app_secret
# Meta WhatsApp Cloud API credentials used only for outbound messages.
WHATSAPP_ACCESS_TOKEN=replace_with_your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_your_whatsapp_phone_number_id
META_GRAPH_API_VERSION=vXX.X
# Browser frontend origin used by WhatsApp CTA links and exact-origin CORS.
PUBLIC_FRONTEND_BASE_URL=https://www.zeexco.com
WHATSAPP_ONBOARDING_RETURN_URL=https://wa.me/
WHATSAPP_ONBOARDING_TOKEN_TTL=30m
# Meta Flow ID for WhatsApp-native merchant registration. Leave blank to use the browser CTA fallback.
WHATSAPP_MERCHANT_REGISTRATION_FLOW_ID=
# Meta supports only published (the safe default) or draft (test environments only).
WHATSAPP_FLOW_MODE=published
WHATSAPP_WEBHOOK_WORKER_POLL_INTERVAL=250ms
WHATSAPP_WEBHOOK_RETRY_DELAY=5s
WHATSAPP_WEBHOOK_PROCESSING_LEASE=5m
WHATSAPP_WEBHOOK_MAX_ATTEMPTS=5
# RSA private key used only to decrypt Meta WhatsApp Flow endpoint requests.
# Store PEM with escaped/newline-preserving environment configuration; never commit a real key.
WHATSAPP_FLOW_PRIVATE_KEY=
# Required only when the configured legacy PKCS#1 PEM is encrypted.
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=
